# ─────────────────────────────────────────────────────────────
#  FIREBASE CREDENTIALS
# ─────────────────────────────────────────────────────────────
#  1. Create a project at https://console.firebase.google.com
#  2. Add a Web app (</> icon) — no hosting needed at this stage
#  3. Copy the config values into the variables below
#  4. Save this file as `.env` (not `.env.example`)
#
#  These values are PUBLIC by design — a Firebase web config is
#  visible in every client bundle. Your data is protected by the
#  Firestore security rules in `firestore.rules`, not by hiding
#  these keys. Deploy those rules before going live.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
